VITE_BASE=/vue-vben-ims-prototype/

# 静态原型演示：登录、用户及权限使用浏览器内模拟，不依赖外部 Mock 服务
VITE_STATIC_DEMO=true
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
